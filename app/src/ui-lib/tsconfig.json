{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",

    "lib": ["DOM", "ES2022"],

    "jsx": "react-jsx",

    "strict": true,

    "moduleResolution": "Bundler",

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "declarationMap": true,

    "sourceMap": true,

    "outDir": "dist",

  },

  "exclude": [
    "node_modules",
    "dist"
  ]
}