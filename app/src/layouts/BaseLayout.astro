---
import "../ui-lib/css/index.css";
import "../styles/global.css";

import { AppHeader } from "../components/shell/app-header/AppHeader";
import { AppFooter } from "../components/shell/app-footer/AppFooter";
import { FindMe } from "../components/shell/find-me/FindMe";

const currentPath = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>Mursu Lab</title>
  </head>

  <body class="app-shell">
    <AppHeader currentPath={currentPath} client:load />

    <main class="page-shell">
      <slot />
    </main>

    <FindMe client:load />
    <AppFooter/>
  </body>
</html>